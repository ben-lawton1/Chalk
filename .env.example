# Copy to .env (git-ignored). Host folder that holds your notebooks; Chalk reads and writes it directly.
# Forward slashes work on Windows. Default when unset: %USERPROFILE%/Documents/Chalk
CHALK_LIBRARY=C:/Users/you/Documents/Chalk

# Origins allowed to frame Chalk (embed mode, used by Atlas) and to talk to it by postMessage. Comma-separated.
# Also sent as Content-Security-Policy: frame-ancestors. Default: Atlas on :8090.
CHALK_EMBED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
